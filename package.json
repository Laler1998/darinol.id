  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--disable-warning=DEP0169 next dev",
    "dev:fresh": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && cross-env NODE_OPTIONS=--disable-warning=DEP0169 next dev",

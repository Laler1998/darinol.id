    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "rss-parser": "^3.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "cross-env": "^10.0.0",
    "postcss": "latest",
